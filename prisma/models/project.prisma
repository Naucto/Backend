enum MonetizationType {
  NONE
  ADS
  PAID
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Project {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // The number a project was known by while ids were integers, kept to translate the public links
  // written then. Null for every project created since; nothing else reads it.
  legacyId     Int?              @unique
  name         String
  shortDesc    String
  longDesc     String?
  tags         String[]          @default([])
  publishedName      String?
  publishedShortDesc String?
  publishedLongDesc  String?
  publishedTags      String[]          @default([])
  status       ProjectStatus     @default(IN_PROGRESS)
  iconUrl      String?
  // Version of the stored cover, read back from the store when it was uploaded; null for a cover
  // stored before the version was kept, or when there is none.
  coverVersion String?
  // The colours the game draws with, as `#rrggbb` in the order the game indexes them. Mirrored
  // from the game's content by its editor, so a client can read them without the engine; empty
  // until an editor wrote them.
  palette      String[]          @default([])
  // The disk its author chose for the game: a colour and a finish, set together. Null until
  // chosen: a client then derives a colour from the id.
  diskColor   String?
  diskFinish  String?
  diskColor2  String?
  diskGradDir String?
  // Version of the stored clip, written when it was uploaded; null without a clip. It is all the
  // row says of the clip: its address is derived from the project id.
  clipVersion String?
  monetization MonetizationType  @default(NONE)
  price        Float?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  publishedAt  DateTime?
  // Set while moderation withholds the game: it leaves the hub and its release stops being served,
  // while `publishedAt` stays so a restore puts it back as it was.
  hiddenAt     DateTime?
  // When the game first reached the hub; later releases and a republish leave it alone.
  firstPublishedAt DateTime?
  // Bumped on each release transition (publish, content change, unpublish); keys its analytics fact.
  releaseRevision    Int     @default(0)
  // Hash of the released content and published metadata, so republishing them unchanged is no-op.
  releaseContentHash String?
  userId       String            @db.Uuid

  // Logical size breakdown of the last saved content (see src/routes/project/content-size.ts)
  contentSize      Json? @map("content_size")
  contentSizeTotal Int?  @map("content_size_total")

  forkedFromId String?           @db.Uuid @map("forked_from_id")

  forkedFrom    Project?      @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks         Project[]     @relation("ProjectForks")
  creator       User          @relation("ProjectCreator", fields: [userId], references: [id])
  collaborators User[]        @relation("ProjectCollaborators")
  comments      Comment[]
  gameSessions  GameSession[]
  workSession   WorkSession?
  userLikes     Like[]
  featuredReleases FeaturedRelease[]
  releaseViews  ReleaseView[]
  collectionItems CollectionItem[]

  viewCount     Int @default(0)
  uniquePlayers Int @default(0)
  likes         Int @default(0)
}

model Comment {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  author    User      @relation(fields: [authorId], references: [id])
  authorId  String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String    @db.Uuid
  parentId  String?   @db.Uuid
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  content   String
  deleted   Boolean   @default(false)
  // Set while moderation has removed the comment. The content stays stored so a restore brings it
  // back, and is never served meanwhile.
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

// One row per viewer per UTC day on a release; viewCount moves only when a row lands, so a
// reload is not a view. viewerKey is the user's id, or a keyed hash of the address when anonymous.
model ReleaseView {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String   @db.Uuid
  viewerKey String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([projectId, viewerKey, day])
  @@index([projectId, viewerKey])
}
