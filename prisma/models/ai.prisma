// AI assistance: scoped MCP credentials, shared editor context, reviewable proposals, the
// proposals, how a proposal is applied, specialist generation jobs and provenance declarations.

model AiConnection {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  projectId Int
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
}

model AiContext {
  id        String   @id @default(uuid())
  projectId Int
  userId    Int
  hash      String
  content   Json
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model AiProposal {
  id           String   @id @default(uuid())
  projectId    Int
  userId       Int
  title        String
  summary      String
  snapshotHash String
  operations   Json
  contentHash  String
  status       String   @default("PENDING")
  reviewedBy   Int?
  revertsId    String?
  // Native operations that undo this proposal, captured from the merged state at commit.
  inverse      Json?
  // How old the shared state this was written against was, so a person applying a change nobody
  // made today can see how far back it reaches instead of assuming it is current. Carried to a
  // revert, which is written against the same state.
  baseContextAgeMs Int @default(0)
  // When the change was claimed, and when storage was first seen to hold it.
  //
  // `storedAt` is what makes "applied but never stored" something the server knows rather than
  // something a person has to notice: the document carries an `ai.applied` receipt for every commit,
  // and a save writes them out, so the first save whose bytes contain this proposal's receipt sets
  // this. Null with a status of APPLIED means the change is committed to in a document that has not
  // been persisted — the reply was lost, or the tab closed before the first save. That proposal can
  // be applied again, because nothing anywhere holds the change; reverting it cannot work, since
  // there is nothing to take back out.
  appliedAt     DateTime?
  storedAt      DateTime?
  // Set on a row that came from applying part of a larger proposal. The parent stays PENDING, so the
  // rest of it can still be applied; this row is what the applied part is recorded as, and so what a
  // revert of that part stages against.
  parentId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  // For the sweep that reports proposals committed to but not yet stored.
  @@index([status, storedAt])
  @@index([parentId])
}

model AiJob {
  id              String   @id @default(uuid())
  projectId       Int
  userId          Int
  kind            String
  state           String   @default("QUEUED")
  request         Json
  result          Json?
  error           String?
  model           String?
  cancelRequested Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model AiDeclaration {
  id         String   @id @default(uuid())
  projectId  Int
  userId     Int
  categories String[]
  note       String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
