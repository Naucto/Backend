// A long-lived assistant credential the account owner creates once. It reaches every project the
// account owns: there is no per-project token and nothing to link.

model AiKey {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     Int
  name       String    @default("Assistant")
  // null never expires. A user who wants a hard limit sets one: "refresh every N weeks" is a date.
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  // Cascade with the account: a key outliving its owner would outlive the membership it depends on.
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
