// A fixed palette rather than a free colour: each accent has to read against both themes and stay
// distinct from the accents that mean "act" and "danger".
enum PersonalColour {
  SKY
  BLUSH
  JADE
  GOLD
  ORANGE
  HOT
}

enum SessionJoinPolicy {
  ANYONE
  FRIENDS
  CODE_ONLY
}

model User {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // What a game reads as `net.id()`, and nothing else. Published games compute on it, so it stays
  // a small integer; no route, key or relation takes it.
  playerNumber     Int             @unique @default(autoincrement())
  email     String   @unique
  username  String   @unique
  nickname  String?
  description String?
  // Null until picked: a colour is then derived from the id, so everyone has one from day one.
  colour    PersonalColour?
  password  String?
  createdAt DateTime @default(now())

  // Crockford base32 code a person shares to be added as a friend; null until first read, which
  // generates it.
  friendCode        String?           @unique
  sessionJoinPolicy SessionJoinPolicy @default(ANYONE)
  // Soft-delete marker: set by account deletion, rejected by the JWT strategy.
  deletedAt         DateTime?
  // Set while moderation has suspended the account. No end date means until staff reinstate it.
  suspendedAt       DateTime?
  suspendedUntil    DateTime?

  // One of the role constants in src/auth/access/roles.ts; text rather than an enum so a role can be
  // added without a type migration.
  role String @default("User")

  friendsInitiated Friendship[]    @relation("UserAFriends")
  friendsReceived  Friendship[]    @relation("UserBFriends")
  sentRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedRequests FriendRequest[] @relation("ReceivedFriendRequests")
  comments         Comment[]
  likes            Like[]
  creator          Project[]       @relation("ProjectCreator")
  collaborators    Project[]       @relation("ProjectCollaborators")

  // FIXME: After merge, refactor those fields to joinedWorkSessions/hostingWorkSessions
  workSession    WorkSession[] @relation("WorkSessionUsers")
  hostingSession WorkSession[] @relation("WorkSessionHost")

  joinedGameSessions  GameSession[] @relation("UserJoinedGameSessions")
  hostingGameSessions GameSession[] @relation("UserHostedGameSessions")

  refreshTokens RefreshToken[]
  notifications Notification[]
  featuredReleases FeaturedRelease[] @relation("FeaturedReleaseCurator")

  analyticsVisitors       AnalyticsVisitor[]
  analyticsDays           AnalyticsUserDaily[]
  analyticsProjectionWork AnalyticsProjectionWork[]

  reports        Report[]
  feedbackPrompt FeedbackPrompt?

  flagsFiled             Flag[]             @relation("FlagsFiled")
  flagsResolved          Flag[]             @relation("FlagsResolved")
  moderationActionsTaken ModerationAction[] @relation("ModerationActionsTaken")
  moderationRecord       ModerationAction[] @relation("ModerationRecord")

  collections Collection[]
}

model RefreshToken {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model FriendRequest {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  from      User     @relation("SentFriendRequests", fields: [fromId], references: [id], onDelete: Cascade)
  fromId    String   @db.Uuid
  to        User     @relation("ReceivedFriendRequests", fields: [toId], references: [id], onDelete: Cascade)
  toId      String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

// Canonical pair order: userAId < userBId in the order Postgres gives `uuid` (enforced by
// FriendsService), so a friendship is stored exactly once and looked up without an OR.
model Friendship {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userA     User     @relation("UserAFriends", fields: [userAId], references: [id], onDelete: Cascade)
  userAId   String   @db.Uuid
  userB     User     @relation("UserBFriends", fields: [userBId], references: [id], onDelete: Cascade)
  userBId   String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}
