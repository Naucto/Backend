{
    "name": "naucto-backend",
    "version": "0.1.0",
    "description": "REST and WebSocket API of the Naucto fantasy console",
    "private": true,
    "license": "GPLv3",
    "scripts": {
        "build": "nest build",
        "seed:dev": "tsx prisma/seed-dev.ts",
        "seed:analytics": "tsx prisma/seed-analytics.ts",
        "analytics:acceptance": "tsx prisma/analytics-acceptance.ts",
        "generate:swagger": "ts-node -r tsconfig-paths/register tool/generate-swagger.ts",
        "generate:client": "openapi-ts",
        "repair:publish-state": "node dist/tasks/repair/repair-publish-state.main",
        "repair:publish-state:dev": "ts-node -r tsconfig-paths/register src/tasks/repair/repair-publish-state.main.ts",
        "repair:release-view-keys": "node dist/tasks/repair/repair-release-view-keys.main",
        "repair:release-view-keys:dev": "ts-node -r tsconfig-paths/register src/tasks/repair/repair-release-view-keys.main.ts",
        "format": "prettier --write \"{src,test,prisma,tool}/**/*.ts\" \"*.{ts,mjs}\"",
        "start": "npm run build && node dist/main",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "clean": "find ./src -type f \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete",
        "lint": "npm run lint:check -- --fix",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "prepare": "husky || true",
        "lint:check": "eslint \"{src,test,prisma,tool}/**/*.ts\" \"*.{ts,mjs}\"",
        "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
        "client:build": "npm run generate:swagger && npm run generate:client && npm --prefix client install --no-audit --no-fund && npm --prefix client run build"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.975.0",
        "@aws-sdk/lib-storage": "^3.986.0",
        "@nestjs/common": "^11.1.12",
        "@nestjs/core": "^11.1.12",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.12",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/swagger": "^11.2.5",
        "@nestjs/throttler": "^6.7.1",
        "@prisma/adapter-pg": "7.8.0",
        "@prisma/client": "7.8.0",
        "@tygra/nestjs-graceful-shutdown": "^2.0.0",
        "bcryptjs": "^3.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "cookie-parser": "^1.4.7",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "isbot": "^5.2.2",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.0.1",
        "maxmind": "^5.0.7",
        "multer": "^2.0.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.18.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ua-parser-js": "^1.0.41",
        "uuid": "^14.0.0",
        "ws": "^8.19.0",
        "yjs": "^13.6.32"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@hey-api/openapi-ts": "^0.99.0",
        "@nestjs/cli": "^12.0.8",
        "@nestjs/testing": "^12.1.2",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^26.6.4",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^7.2.1",
        "@types/ua-parser-js": "^0.7.39",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "prisma": "7.10.0",
        "supertest": "^7.3.1",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.1"
    },
    "packageManager": "npm@11.8.0",
    "engines": {
        "node": ">=22"
    }
}
