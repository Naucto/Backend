# Runtime
NODE_ENV=
# Port the server listens on inside the container; defaults to 3000 if unset.
PORT=
# Host port docker-compose publishes the backend on; also the build arg that becomes PORT in the image.
BACKEND_PORT=
# Origin allowed through CORS; defaults to http://localhost:3001 if unset.
FRONTEND_URL=

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Full connection string, e.g. postgresql://user:password@db:5432/dbname ("db" = the compose
# service name). Required: the server always runs in a container and reads this directly.
# When unset, prisma.config.ts, prisma/seed-dev.ts and the Prisma CLI build one from the POSTGRES_*
# values above instead, always against "localhost" — that fallback is for commands run from the
# host (migrate dev, seed:dev), reached through the port docker-compose publishes, since a compose
# service name does not resolve outside the container network.
DATABASE_URL=

# Tokens and secrets
JWT_SECRET=
# Keys the hash that stands for an anonymous reader in the view count; falls back to JWT_SECRET.
VIEW_HASH_SECRET=
# Access token lifetime as a duration string (e.g. "1h"); defaults to 1h if unset.
JWT_EXPIRES_IN=
# Refresh token lifetime, same duration format as above; defaults to 7d if unset.
JWT_REFRESH_EXPIRES_IN=
# AES-256-GCM key encrypting the refresh-token cookie; falls back to JWT_SECRET when unset.
REFRESH_TOKEN_ENCRYPTION_KEY=

# OAuth providers
# A provider missing any of its variables is disabled with a warning; the server still boots.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=

# Object storage and the edge URL the browser is handed
# For local development, docker-compose.dev.yml brings up MinIO with these defaults — leave them as
# they are and a published release is playable on localhost. In any other environment these are
# real credentials and must not be committed.
#   S3_ENDPOINT   is what the backend container talks to (service name on the compose network).
#   EDGE_ENDPOINT is the base of the URLs the browser fetches covers and releases from, so it must
#                 be reachable from the user's machine, not only from the compose network.
S3_ACCESS_KEY_ID=naucto
S3_SECRET_ACCESS_KEY=naucto-dev-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=naucto-dev
# Autosave slots kept per project, oldest pruned (default 4). A slot is one key rewritten by every
# save inside S3_AUTO_HISTORY_DELAY minutes (default 10); past that a new slot opens. Named
# versions are checkpoints, counted separately up to S3_MAX_CHECKPOINTS (default 20); saving
# under a name that exists rewrites that version.
S3_MAX_AUTO_HISTORY_VERSION=
S3_AUTO_HISTORY_DELAY=
S3_MAX_CHECKPOINTS=
EDGE_ENDPOINT=http://localhost:9000/naucto-dev

# WebRTC signalling and relays
# Hostname embedded in signalling URLs when BACKEND_WEBRTC_PUBLIC_URL_TEMPLATE is unset; "localhost"
# is also the value the app checks to detect a local dev run.
BACKEND_WEBRTC_HOSTNAME=
# Port range the three WebRTC servers bind, one each sequential from PORT_BASE (default 10000);
# must match the range docker-compose publishes.
BACKEND_WEBRTC_PORT_BASE=
BACKEND_WEBRTC_PORT_END=
# Production only: public URL template for each WebSocket server, e.g. wss://{name}.ws.beta.naucto.net
# ({name} = collab | game | user, {port} = bound port). Unset = ws(s)://BACKEND_WEBRTC_HOSTNAME:{port}
BACKEND_WEBRTC_PUBLIC_URL_TEMPLATE=
# config/webrtc.json is required in every environment (start from config/webrtc.example.json): it
# carries the connection limit and a static relay list. Production only: set both variables below
# to replace that list with short-lived TURN credentials minted from the relay provider's API.
BACKEND_WEBRTC_TURN_KEY_ID=
BACKEND_WEBRTC_TURN_API_TOKEN=

# Analytics
# Optional: path, inside the container, of an IP-to-country database in MMDB format. DB-IP Lite
# Country (CC BY 4.0, https://db-ip.com, credited on the privacy page) or MaxMind GeoLite2 Country.
# Mount the file; never bake it into the image or commit it, as neither licence allows republishing
# it in a public image. Unset = analytics records no country. The address itself is never stored.
GEOIP_DB_PATH=

# Development only
# Optional: set to false to stop serving Swagger UI; the production image sets this already.
#ENABLE_SWAGGER=false
