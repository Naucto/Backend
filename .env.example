# Object storage. For local development, docker-compose.dev.yml brings up MinIO with these
# defaults — leave them as they are and a published release is playable on localhost. In any other
# environment these are real credentials and must not be committed.
#   S3_ENDPOINT   is what the backend container talks to (service name on the compose network).
#   EDGE_ENDPOINT is what the *browser* is handed, so it must be reachable from the host.
S3_ACCESS_KEY_ID=naucto
S3_SECRET_ACCESS_KEY=naucto-dev-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=naucto-dev
S3_MAX_AUTO_HISTORY_VERSION=
S3_AUTO_HISTORY_DELAY=
S3_MAX_CHECKPOINTS=
EDGE_ENDPOINT=http://localhost:9000/naucto-dev

CDN_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PRIVATE_KEY_PATH=

SCW_PROJECT_ID=
SCW_ORGANIZATION_ID=

BACKEND_WEBRTC_HOSTNAME=
BACKEND_WEBRTC_PORT_BASE=
BACKEND_WEBRTC_PORT_END=

NPM_REGISTRY=
PRISMA_MIRROR=
